<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/lab1/games#"
     xml:base="http://www.semanticweb.org/lab1/games"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/lab1/games">
        <rdfs:comment xml:lang="ru">Онтология &apos;Видеоигры&apos;, построенная по базе знаний games.pl (Prolog)</rdfs:comment>
    </owl:Ontology>
    


    <!-- Object Properties -->

    <!-- http://www.semanticweb.org/lab1/games#countryOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#countryOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:comment xml:lang="ru">Обратное к madeIn</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lab1/games#hasGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#hasGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
        <rdfs:comment xml:lang="ru">Prolog: has_genre/2</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lab1/games#madeIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#madeIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lab1/games#countryOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
        <rdfs:comment xml:lang="ru">Prolog: made_in/2</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lab1/games#makesGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#makesGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#countryOf"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#hasGenre"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="ru">Prolog-правило country_genre/2: countryOf o hasGenre</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lab1/games#sameCountryAs -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#sameCountryAs">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#madeIn"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#countryOf"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="ru">Prolog-правило same_country/2: madeIn o countryOf (в OWL нет условия G1 != G2, поэтому игра связана и сама с собой)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- Classes -->

    <!-- http://www.semanticweb.org/lab1/games#CasualGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#CasualGame">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#NoStoryGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lab1/games#hasGenre"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#puzzle"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#sandbox"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Prolog-правило casual_game/1: NoStoryGame and (hasGenre some {puzzle, sandbox})</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#Country -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#Country">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
        <rdfs:comment xml:lang="ru">Prolog: country/1</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#Game -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#Game">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
        <rdfs:comment xml:lang="ru">Prolog: game/1</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#GameDevCountry -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#GameDevCountry">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#Country"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lab1/games#countryOf"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Prolog-правило game_dev_country/1: Country and (countryOf min 2 Game)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#Genre -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#Genre">
        <rdfs:comment xml:lang="ru">Prolog: genre/1</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#NoStoryGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#NoStoryGame">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#Game"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/lab1/games#StoryGame"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Prolog-правило no_story/1: Game and not StoryGame</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#OpenWorldGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#OpenWorldGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:comment xml:lang="ru">Prolog: open_world/1</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#OpenWorldRPG -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#OpenWorldRPG">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#OpenWorldGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lab1/games#hasGenre"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/lab1/games#rpg"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Prolog-правило open_world_rpg/1: OpenWorldGame and (hasGenre value rpg)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#StoryGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#StoryGame">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#cyberpunk2077"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#dark_souls"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#doom"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#witcher3"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:comment xml:lang="ru">Prolog: has_story/1. Список игр перечислен явно (закрыт), чтобы работало отрицание в NoStoryGame.</rdfs:comment>
    </owl:Class>
    


    <!-- Individuals -->

    <!-- http://www.semanticweb.org/lab1/games#canada -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#canada">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#cyberpunk2077 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#cyberpunk2077">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#StoryGame"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#OpenWorldGame"/>
        <hasGenre rdf:resource="http://www.semanticweb.org/lab1/games#rpg"/>
        <madeIn rdf:resource="http://www.semanticweb.org/lab1/games#poland"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#dark_souls -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#dark_souls">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#StoryGame"/>
        <hasGenre rdf:resource="http://www.semanticweb.org/lab1/games#rpg"/>
        <madeIn rdf:resource="http://www.semanticweb.org/lab1/games#japan"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#doom -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#doom">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#StoryGame"/>
        <hasGenre rdf:resource="http://www.semanticweb.org/lab1/games#shooter"/>
        <madeIn rdf:resource="http://www.semanticweb.org/lab1/games#usa"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#fifa23 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#fifa23">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <hasGenre rdf:resource="http://www.semanticweb.org/lab1/games#sports"/>
        <madeIn rdf:resource="http://www.semanticweb.org/lab1/games#canada"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#japan -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#japan">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#minecraft -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#minecraft">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#OpenWorldGame"/>
        <hasGenre rdf:resource="http://www.semanticweb.org/lab1/games#sandbox"/>
        <madeIn rdf:resource="http://www.semanticweb.org/lab1/games#sweden"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#poland -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#poland">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#puzzle -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#puzzle">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#rpg -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#rpg">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#sandbox -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#sandbox">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#shooter -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#shooter">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#sports -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#sports">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#sweden -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#sweden">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#tetris -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#tetris">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <hasGenre rdf:resource="http://www.semanticweb.org/lab1/games#puzzle"/>
        <madeIn rdf:resource="http://www.semanticweb.org/lab1/games#ussr"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#usa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#usa">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#ussr -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#ussr">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Country"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lab1/games#witcher3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lab1/games#witcher3">
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#StoryGame"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lab1/games#OpenWorldGame"/>
        <hasGenre rdf:resource="http://www.semanticweb.org/lab1/games#rpg"/>
        <madeIn rdf:resource="http://www.semanticweb.org/lab1/games#poland"/>
    </owl:NamedIndividual>
    


    <!-- General axioms -->

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#canada"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#cyberpunk2077"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#dark_souls"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#doom"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#fifa23"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#japan"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#minecraft"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#poland"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#puzzle"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#rpg"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#sandbox"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#shooter"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#sports"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#sweden"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#tetris"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#usa"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#ussr"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#witcher3"/>
        </owl:distinctMembers>
    </rdf:Description>
</rdf:RDF>
