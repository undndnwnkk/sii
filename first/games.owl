<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/lab1/games#"
     xml:base="http://www.semanticweb.org/lab1/games"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/lab1/games">
        <rdfs:comment xml:lang="ru">Онтология &apos;Видеоигры&apos;, построенная по базе знаний games.pl (Prolog)</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lab1/games#developedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#developedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lab1/games#developerOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Developer"/>
        <rdfs:comment xml:lang="ru">Prolog: developed_by/2</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lab1/games#developerOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#developerOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Developer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:comment xml:lang="ru">Обратное к developedBy</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lab1/games#hasGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#hasGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
        <rdfs:comment xml:lang="ru">Prolog: has_genre/2</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lab1/games#sameDeveloperAs -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#sameDeveloperAs">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#developedBy"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#developerOf"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="ru">Prolog-правило same_developer/2: developedBy o developerOf (в OWL нет условия G1 != G2, поэтому игра связана и сама с собой)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lab1/games#worksInGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lab1/games#worksInGenre">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lab1/games#Developer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#developerOf"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#hasGenre"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="ru">Prolog-правило developer_genre/2: developerOf o hasGenre</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lab1/games#Developer -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#Developer">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
        <rdfs:comment xml:lang="ru">Prolog: developer/1</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#Game -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#Game">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lab1/games#Genre"/>
        <rdfs:comment xml:lang="ru">Prolog: game/1</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#GameForFriends -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#GameForFriends">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#MultiplayerGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lab1/games#hasGenre"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#sandbox"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#shooter"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#sports"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Prolog-правило good_for_friends/1: MultiplayerGame and (hasGenre some {sports, shooter, sandbox})</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#Genre -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#Genre">
        <rdfs:comment xml:lang="ru">Prolog: genre/1</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#MultiGameStudio -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#MultiGameStudio">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#Developer"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lab1/games#developerOf"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Prolog-правило multi_game_studio/1: Developer and (developerOf min 2 Game)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#MultiplayerGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#MultiplayerGame">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#dark_souls"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#doom"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#fifa23"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#minecraft"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:comment xml:lang="ru">Prolog: multiplayer/1. Список игр перечислен явно (закрыт), чтобы работало отрицание в SinglePlayerGame.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#OpenWorldGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#OpenWorldGame">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lab1/games#Game"/>
        <rdfs:comment xml:lang="ru">Prolog: open_world/1</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#OpenWorldRPG -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#OpenWorldRPG">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#OpenWorldGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lab1/games#hasGenre"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/lab1/games#rpg"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Prolog-правило open_world_rpg/1: OpenWorldGame and (hasGenre value rpg)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lab1/games#SinglePlayerGame -->

    <owl:Class rdf:about="http://www.semanticweb.org/lab1/games#SinglePlayerGame">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lab1/games#Game"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/lab1/games#MultiplayerGame"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="ru">Prolog-правило single_player/1: Game and not MultiplayerGame</rdfs:comment>
    </owl:Class>
    


